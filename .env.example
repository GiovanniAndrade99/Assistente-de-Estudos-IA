# Copie este arquivo para ".env" e coloque sua chave.
# Chave gratuita em: https://aistudio.google.com/apikey
GEMINI_API_KEY=cole_sua_chave_aqui

# Modelos (troque se o Google lançar versões novas)
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# "production" liga cookie de sessão seguro (exige HTTPS) e o cabeçalho HSTS.
# Em desenvolvimento local (http://localhost) deixe "development".
APP_ENV=development

# Nível dos logs estruturados (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Tamanho máximo de um PDF enviado, em megabytes
TAMANHO_MAX_UPLOAD_MB=20
