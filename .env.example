# Copie este arquivo para ".env" e coloque sua chave.
# Chave gratuita em: https://aistudio.google.com/apikey
GEMINI_API_KEY=cole_sua_chave_aqui

# Modelos (troque se o Google lançar versões novas)
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# "production" liga cookie de sessão seguro (exige HTTPS) e o cabeçalho HSTS.
# Em desenvolvimento local (http://localhost) deixe "development".
APP_ENV=development

# Nível dos logs estruturados (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Tamanho máximo de um PDF enviado, em megabytes
TAMANHO_MAX_UPLOAD_MB=20

# Envio do código de confirmação de e-mail (cadastro de professor).
# Sem SMTP_HOST, em desenvolvimento o código aparece no terminal do servidor.
# Exemplo Gmail: smtp.gmail.com, porta 587, com uma "senha de app".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Palavra-passe exigida no cadastro para criar conta de professor (evita que
# qualquer visitante marque "Professor" sozinho). Combine com quem realmente
# leciona; troque de vez em quando. Deixar em branco desativa a checagem
# (não recomendado em produção).
CODIGO_PROFESSOR=troque_este_codigo
