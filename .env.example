# Copie este arquivo para ".env" e preencha. O .env fica fora do Git.
# Itens marcados [produção] são obrigatórios com APP_ENV=production: sem eles o servidor não sobe.

# ---------------------------------------------------------------- ambiente
# "production" liga cookie seguro (exige HTTPS), HSTS, desliga /docs e os dados de demonstração.
APP_ENV=development
LOG_LEVEL=INFO
# Alunos e mensagens fictícios para demonstrar chat e calendário (padrão: ligado fora de produção)
# DADOS_DEMO=true

# [produção] Segredo para pseudonimizar IP e e-mail no controle de tentativas. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SEGREDO_APP=

# Exigido no cadastro de conta de professor. Em branco, o cadastro de professor fica desativado
# (responde 503). Combine só com quem leciona e troque de vez em quando.
CODIGO_PROFESSOR=troque_este_codigo

# ---------------------------------------------------------------- Gemini
# Chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=cole_sua_chave_aqui
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODELS_FALLBACK=gemini-3.5-flash,gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
# true só depois de ativar o faturamento (plano pago + Data Processing Addendum). No plano
# gratuito o Google pode usar o conteúdo enviado para melhorar produtos. Aparece no aviso.
GEMINI_PLANO_PAGO=false

# ---------------------------------------------------------------- custo da IA
# Pedidos por pessoa a cada 5 minutos
LIMITE_CHAT_5MIN=20
LIMITE_ESTUDO_5MIN=15
LIMITE_UPLOADS_5MIN=10
# Pedidos ao Gemini por pessoa em 24 h (respostas do cache não contam). 0 = sem cota.
COTA_IA_DIA_ALUNO=60
COTA_IA_DIA_PROFESSOR=200
# Respostas e resumos repetidos saem do cache por N dias (0 desliga o cache)
CACHE_RESPOSTAS_DIAS=7
# Tokens por dia do sistema todo: ALERTA avisa no log e na tela de métricas; TETO pausa a IA até
# o dia seguinte (UTC). 0 desliga.
ALERTA_TOKENS_DIA=0
TETO_TOKENS_DIA=0

# ---------------------------------------------------------------- LGPD
# [produção] Quem trata os dados e como falar com essa pessoa (aparecem no aviso de privacidade)
CONTROLADOR_NOME=
CONTROLADOR_CONTATO=
# Encarregado pelo tratamento (art. 41). Agente de pequeno porte pode dispensar.
ENCARREGADO_NOME=
ENCARREGADO_EMAIL=
# Mudou o aviso de privacidade? Troque a versão: todos confirmam a leitura de novo.
POLITICA_PRIVACIDADE_VERSAO=2026-10-16
# Os termos da API do Gemini exigem 18+. Só baixe se trocar de provedor de IA.
IDADE_MINIMA=18
# Retenção (0 = enquanto a conta existir)
RETENCAO_HISTORICO_MESES=12
RETENCAO_MENSAGENS_MESES=12
RETENCAO_CHAMADOS_MESES=12
RETENCAO_BACKUP_DIAS=30
INTERVALO_LIMPEZA_HORAS=6

# ---------------------------------------------------------------- e-mail (SMTP)
# Confirmação de e-mail, recuperação e troca de senha. Sem SMTP_HOST: em desenvolvimento o link
# vai para o log; em produção esses recursos respondem 503.
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=
# Nome do provedor, para o aviso de privacidade (operador)
SMTP_PROVEDOR_NOME=
# Endereço público do site, usado nos links dos e-mails
APP_URL_BASE=http://localhost:8002

# ---------------------------------------------------------------- outros
TAMANHO_MAX_UPLOAD_MB=20
# Origens extras aceitas em requisições que alteram dados (separadas por vírgula)
ORIGENS_PERMITIDAS=
LIMITE_CADASTROS_POR_IP=10
LIMITE_LOGINS_POR_IP=100
# OCR de PDF escaneado (Tesseract com português)
OCR_HABILITADO=true
OCR_IDIOMAS=por+eng
# Pastas (padrão: data/ e backups/ na raiz do projeto)
# PASTA_DADOS=
# PASTA_BACKUPS=
